# Copy to .env before running `docker compose up --build`.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO

# --- Database (also read by the db container) -----------------------------
POSTGRES_DB=ahoum
POSTGRES_USER=ahoum
POSTGRES_PASSWORD=ahoum
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- JWT ------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- App ------------------------------------------------------------------
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# --- OAuth ----------------------------------------------------------------
# Each provider gets its own callback route: <base>/google and <base>/github.
OAUTH_REDIRECT_BASE=http://localhost:8080/auth/callback

# Google: https://console.cloud.google.com/apis/credentials
#   OAuth client type "Web application"
#   Authorised redirect URI = http://localhost:8080/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
#   Authorization callback URL = http://localhost:8080/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local-only escape hatch so the app can be reviewed without registering an
# OAuth app with either provider. When True, the login page offers a "dev sign-in" that
# posts code="dev:<handle>". MUST stay False anywhere real.
DEV_FAKE_OAUTH=True
